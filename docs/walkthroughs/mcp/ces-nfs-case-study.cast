{"version": 2, "width": 88, "height": 24, "title": "CES and NFS: from failed health checks to confirmation", "duration": 172.9, "env": {"TERM": "xterm-256color"}}
[0, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m01/08  Why CES and NFS stayed inactive\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mHISTORICAL CASE STUDY \u2014 edited reenactment\u001b[0m\r\n\u001b[38;2;243;244;246mDiagnosis in Environment A; confirmation in Environment B.\u001b[0m\r\n\u001b[38;2;243;244;246mFinal successful run covers NFS and SMB, not S3.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[19.78, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m02/08  1. Task success was not service health\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mDEPLOY RECAP LOOKS CLEAN\u001b[0m\r\n\u001b[38;2;243;244;246mSMB, monitoring and GUI ACTIVE.\u001b[0m\r\n\u001b[38;2;243;244;246mCES and NFS NOT ACTIVE.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mCheck service health, not only the Ansible recap.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[40.89, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m03/08  2. Address assignment remains blocked\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mIN THIS FAILED RUN\u001b[0m\r\n\u001b[38;2;243;244;246mCES addresses remain unassigned.\u001b[0m\r\n\u001b[38;2;243;244;246mManual assignment is refused while nodes are unhealthy.\u001b[0m\r\n\u001b[38;2;243;244;246mSuspend/resume briefly clears a flag; it returns.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mThe underlying health problem is still present.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[62.45, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m04/08  3. Inspect the services\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED SERVICE STATUS\u001b[0m\r\n\u001b[38;2;243;244;246mNFS-Ganesha: inactive\u001b[0m\r\n\u001b[38;2;243;244;246mrpcbind.service: masked and inactive\u001b[0m\r\n\u001b[38;2;243;244;246mrpcbind.socket: also masked\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mThe masked dependency prevents normal service startup.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[83.56, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m05/08  4. Confirm and fix in a fresh environment\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mENVIRONMENT B \u2014 before installation\u001b[0m\r\n\u001b[38;2;243;244;246mThe same rpcbind masking is present.\u001b[0m\r\n\u001b[38;2;243;244;246mUnmask service and socket; enable and start both.\u001b[0m\r\n\u001b[38;2;243;244;246mVerify socket listening and service running on both nodes.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mThis is a new run, not a continuation of the failed install.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[105.12, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m06/08  5. Install, then verify directly\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mSETUP AND INSTALLATION SUMMARIZED\u001b[0m\r\n\u001b[38;2;243;244;246mNodes and storage configured; callhome/precheck resolved.\u001b[0m\r\n\u001b[38;2;243;244;246mInstallation runs; log visibility is lost near the end.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mDirect checks: cluster exists, seven nodes active, filesystems present.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[128.01, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m07/08  6. Prepare protocol deployment\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mCONFIRM ADDRESS OWNERSHIP BEFORE USE\u001b[0m\r\n\u001b[38;2;243;244;246mUse the environment\u2019s reserved CES addresses.\u001b[0m\r\n\u001b[38;2;243;244;246mA ping timeout alone does not establish that an IP is free.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mConfigure shared root, interface and address pool.\u001b[0m\r\n\u001b[38;2;243;244;246mEnable NFS and SMB; run deployment precheck.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[150.9, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m08/08  7. Confirm the new deployment\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mFRESH-ENVIRONMENT DEPLOY: 12 minutes 33 seconds\u001b[0m\r\n\u001b[38;2;243;244;246mFilesystem and CES ACTIVE.\u001b[0m\r\n\u001b[38;2;243;244;246mNFS and SMB ACTIVE.\u001b[0m\r\n\u001b[38;2;243;244;246mMonitoring and GUI ACTIVE.\u001b[0m\r\n\u001b[38;2;243;244;246mSUCCESS \u2014 all services running.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
