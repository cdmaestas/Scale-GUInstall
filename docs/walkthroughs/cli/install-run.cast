[0, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m01/18  A real run, command by command\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mREAL RUN | 2026-10-06 | IBM Storage Scale 6.0.1.1\u001b[0m\r\n\u001b[38;2;243;244;246mInstaller node plus seven cluster nodes | NFS, SMB and S3\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mCommands are the ones the backend executed on the installer\u001b[0m\r\n\u001b[38;2;243;244;246mnode. Output lines are quoted from the toolkit's own logs.\u001b[0m\r\n\u001b[38;2;243;244;246mThe toolkit path is shortened to \".../\" and INFO markers are\u001b[0m\r\n\u001b[38;2;243;244;246mdropped. \"+m:ss\" times are real: seconds since the toolkit's\u001b[0m\r\n\u001b[38;2;243;244;246mlog opened. Playback pacing is generated.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mThe GUI and the MCP tools run these same commands.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[35.78, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m02/18  1. Start the installation service\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale setup -s 10.249.129.192\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       2.5s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mThe backend did not save the setup output in this run;\u001b[0m\r\n\u001b[38;2;243;244;246monly the command and its time window are shown.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[59.11, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m03/18  2. Define the seven nodes\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale node delete scale-server1\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale node add scale-gui1 -g -q -a\u001b[0m\r\n\u001b[38;2;243;244;246m(one delete and one add for each of the seven nodes)\u001b[0m\r\n\u001b[38;2;243;244;246m[ FATAL ] Node scale-server1-l7kej84k does not exist in the current configuration.\u001b[0m\r\n\u001b[38;2;243;244;246mCheck environment with 'spectrumscale node list'.\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] Found a mis-ordered line in the /etc/hosts file on scale-server1-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mwhich is incorrectly formatted. This may affect initial cluster creation. In case of\u001b[0m\r\n\u001b[38;2;243;244;246mfailure during initial cluster creation, please format the entries in the /etc/hosts\u001b[0m\r\n\u001b[38;2;243;244;246mas '<IP> <FQDN> <ALIAS>') and retry\u001b[0m\r\n\u001b[38;2;243;244;246mAdding node scale-server1-l7kej84k as a quorum node.\u001b[0m\r\n\u001b[38;2;243;244;246mAdding node scale-server1-l7kej84k as an NSD server.\u001b[0m\r\n\u001b[38;2;243;244;246mSetting scale-gui1-l7kej84k as an admin node.\u001b[0m\r\n\u001b[38;2;243;244;246mSetting scale-proto1-l7kej84k as a protocol node.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[84.22, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m04/18  3. Read back the node table\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mGPFS                   Admin  Quorum  Manager   NSD   Protocol   GUI    Perf Mon\u001b[0m\r\n\u001b[38;2;243;244;246mNode                    Node   Node     Node   Server   Node    Server Collector\u001b[0m\r\n\u001b[38;2;243;244;246mscale-client1-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mscale-client2-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mscale-gui1-l7kej84k      X       X                                X        X\u001b[0m\r\n\u001b[38;2;243;244;246mscale-proto1-l7kej84k                    X                X\u001b[0m\r\n\u001b[38;2;243;244;246mscale-proto2-l7kej84k                    X                X\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server1-l7kej84k           X       X       X                         X\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server2-l7kej84k           X       X       X\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m[Protocols]\u001b[0m\r\n\u001b[38;2;243;244;246mS3     : Enabled\u001b[0m\r\n\u001b[38;2;243;244;246mSMB    : Enabled\u001b[0m\r\n\u001b[38;2;243;244;246mNFS    : Enabled\u001b[0m\r\n\u001b[38;2;243;244;246mHDFS   : Disabled\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRead after the protocols were applied (step 6).\u001b[0m\r\n\u001b[38;2;243;244;246m(OS and architecture columns, rhel9 x86_64, trimmed to fit)\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[111.11, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m05/18  4. Define the storage\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale nsd add -p scale-server1 -u dataAndMetadata -fg 1 -fs\u001b[0m\r\n\u001b[38;2;243;244;246mcesSharedRoot /dev/vdd\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale nsd add -p scale-server1 -u dataOnly -fg 1 -po data -fs\u001b[0m\r\n\u001b[38;2;243;244;246mfs1 /dev/vdf\u001b[0m\r\n\u001b[38;2;243;244;246m(six NSD adds in all; the other four were not seen echoed)\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mName FS            Size(GB) Usage           FG Pool    Device   Servers\u001b[0m\r\n\u001b[38;2;243;244;246mnsd1 cesSharedRoot 100.0    dataAndMetadata 1  system  /dev/vdd scale-server1-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd2 fs1           100.0    dataAndMetadata 1  Default /dev/vde scale-server1-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd3 fs1           100.0    dataOnly        1  data    /dev/vdf scale-server1-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd4 cesSharedRoot 100.0    dataAndMetadata 2  Default /dev/vdd scale-server2-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd5 fs1           100.0    dataAndMetadata 2  Default /dev/vde scale-server2-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd6 fs1           100.0    dataOnly        2  data    /dev/vdf scale-server2-l7kej84k\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[137.55, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m06/18  5. Call home and cluster settings\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale callhome disable\u001b[0m\r\n\u001b[38;2;243;244;246mDisabling the callhome.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale config gpfs --ephemeral_port_range 60000-61000\u001b[0m\r\n\u001b[38;2;243;244;246mSetting ephemeral_port_range to 60000-61000\u001b[0m\r\n\u001b[38;2;243;244;246mSetting perfmon to on\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mCall home is on by default; it must be configured or\u001b[0m\r\n\u001b[38;2;243;244;246mdisabled before the install precheck will pass.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[154.66, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m07/18  6. Configure and enable the protocols\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale config protocols -f cesSharedRoot -m /ibm/cesSharedRoot\u001b[0m\r\n\u001b[38;2;243;244;246m-i eth1 -e 10.249.128.200,10.249.128.201\u001b[0m\r\n\u001b[38;2;243;244;246mSetting export_ip_pool to ['10.249.128.200', '10.249.128.201']\u001b[0m\r\n\u001b[38;2;243;244;246mSetting filesystem to cesSharedRoot\u001b[0m\r\n\u001b[38;2;243;244;246mSetting mountpoint to /ibm/cesSharedRoot\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN ] CIDR value has not been passed with Export ces ip's, Installer will\u001b[0m\r\n\u001b[38;2;243;244;246mcontinue to work on Legacy mode.\u001b[0m\r\n\u001b[38;2;243;244;246mSetting interface to eth1\u001b[0m\r\n\u001b[38;2;243;244;246m[OK] Protocol configuration set.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale enable nfs smb s3\u001b[0m\r\n\u001b[38;2;243;244;246m[OK] Enabled: nfs, smb, s3.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[181.55, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m08/18  7. Precheck the install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale install --precheck\u001b[0m\r\n\u001b[38;2;243;244;246mGPFS precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mNetwork check from admin node scale-gui1-l7kej84k to all other nodes in the cluster\u001b[0m\r\n\u001b[38;2;243;244;246mpassed\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] NSDs on the node scale-server1-l7kej84k may not be load-balanced\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] Only one GUI server specified. The Graphical User Interface will not be\u001b[0m\r\n\u001b[38;2;243;244;246mhighly available.\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] The NSD nsd1 only has one server configured. This may affect the ability\u001b[0m\r\n\u001b[38;2;243;244;246mto run concurrent maintenance on this cluster.\u001b[0m\r\n\u001b[38;2;243;244;246mscale-client1-l7kej84k     : ok=10   changed=0    unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=22   rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246mPre-check successful for install.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       1m 26.0s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[211.55, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m09/18  8. Run the install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale install\u001b[0m\r\n\u001b[38;2;243;244;246m+7:38.4  task: create new cluster\u001b[0m\r\n\u001b[38;2;243;244;246m4 x FAILED - RETRYING: wait-daemon-active (scale-server1)\u001b[0m\r\n\u001b[38;2;243;244;246m+10:09.3    (all logged at one instant; see next chapter)\u001b[0m\r\n\u001b[38;2;243;244;246m+10:28.0  task: create new NSDs\u001b[0m\r\n\u001b[38;2;243;244;246m+12:04.4  task: create new filesystem(s)\u001b[0m\r\n\u001b[38;2;243;244;246m2 x FAILED - RETRYING: wait for gpfsgui (scale-gui1)\u001b[0m\r\n\u001b[38;2;243;244;246m+24:00.6  play recap (every host failed=0)\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server1-l7kej84k     : ok=160  changed=38   unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=362  rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246mscale-gui1-l7kej84k        : ok=90   changed=18   unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=165  rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246m+24:30.8  finished\u001b[0m\r\n\u001b[38;2;243;244;246mInstallation successful. 7 GPFS nodes active in cluster scale-gui1-l7kej84k.\u001b[0m\r\n\u001b[38;2;243;244;246mCompleted in 24 minutes 32 seconds.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       24m 33.5s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[254.88, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m10/18  Install: where the time went\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mLongest gaps between TASK lines in the install log:\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mseconds  start   task\u001b[0m\r\n\u001b[38;2;243;244;246m 143.6s  +3:12.0  core_install : install | List installed GPFS packages\u001b[0m\r\n\u001b[38;2;243;244;246m 130.2s  +8:01.8  core_configure : cluster | Start daemons\u001b[0m\r\n\u001b[38;2;243;244;246m  95.2s  +13:49.5  afm_cos_install : install | Install GPFS HPT packages\u001b[0m\r\n\u001b[38;2;243;244;246m  90.0s  +16:57.0  perfmon_install : install | Install GPFS Zimon packages\u001b[0m\r\n\u001b[38;2;243;244;246m  87.8s  +12:21.6  afm_cos_install : install | Add GPFS AFM COS package to list\u001b[0m\r\n\u001b[38;2;243;244;246m  86.7s  +18:29.5  gui_install : install | Add GUI RPMs to list\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRetry lines are written when a task returns, so all\u001b[0m\r\n\u001b[38;2;243;244;246mfour wait-daemon-active retries carry the same\u001b[0m\r\n\u001b[38;2;243;244;246mtimestamp. They show that retries happened, not when.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[295.55, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m11/18  9. Check the install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale install --postcheck\u001b[0m\r\n\u001b[38;2;243;244;246m5 server licenses and 2 client licenses enabled on the cluster. Ensure enough\u001b[0m\r\n\u001b[38;2;243;244;246mlicenses are owned for this configuration.\u001b[0m\r\n\u001b[38;2;243;244;246mGPFS ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mNSDs ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mPerformance Monitoring ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mGUI ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mSUCCESS\u001b[0m\r\n\u001b[38;2;243;244;246mAll services running\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       12.5s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[319.33, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m12/18  10. Precheck the deploy\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale deploy --precheck\u001b[0m\r\n\u001b[38;2;243;244;246mNSDs are in a valid state\u001b[0m\r\n\u001b[38;2;243;244;246mprotocol precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mS3 precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mSMB precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mNFS precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mNetwork check from protocol node scale-proto2-l7kej84k to all other protocol nodes\u001b[0m\r\n\u001b[38;2;243;244;246min the cluster passed\u001b[0m\r\n\u001b[38;2;243;244;246mPre-check successful for deploy.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       2m 36.9s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
