[414.0, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m16/18  13. Verify the export addresses\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo /usr/lpp/mmfs/bin/mmces address list\u001b[0m\r\n\u001b[38;2;243;244;246mAddress          Node                    Ces Group   Attributes\u001b[0m\r\n\u001b[38;2;243;244;246m---------------- ----------------------- ----------- ------------\u001b[0m\r\n\u001b[38;2;243;244;246m10.249.128.200   scale-proto1-l7kej84k   none        none\u001b[0m\r\n\u001b[38;2;243;244;246m10.249.128.201   scale-proto2-l7kej84k   none        none\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo /usr/lpp/mmfs/bin/mmces service list -a\u001b[0m\r\n\u001b[38;2;243;244;246mEnabled services: NFS SMB S3\u001b[0m\r\n\u001b[38;2;243;244;246mscale-proto1-l7kej84k:  NFS is running, SMB is running, S3 is running\u001b[0m\r\n\u001b[38;2;243;244;246mscale-proto2-l7kej84k:  NFS is running, SMB is running, S3 is running\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m(run on scale-proto1 over SSH from the installer node)\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
[436.44, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m17/18  14. The SMB TIPS status\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo /usr/lpp/mmfs/bin/mmhealth node show SMB -v\u001b[0m\r\n\u001b[38;2;243;244;246mSMB           TIPS          2026-10-06 18:08:27\u001b[0m\r\n\u001b[38;2;243;244;246msmb_sensors_not_configured(SMBGlobalStats, SMBStats)\u001b[0m\r\n\u001b[38;2;243;244;246msmb_sensors_not_configured  SMB        TIP         2026-10-06 18:08:27  The SMB\u001b[0m\r\n\u001b[38;2;243;244;246mperfmon sensor SMBGlobalStats is not configured.\u001b[0m\r\n\u001b[38;2;243;244;246mctdb_state_up               SMB        INFO        2026-10-06 18:08:27  The CTDB\u001b[0m\r\n\u001b[38;2;243;244;246mstate is healthy.\u001b[0m\r\n\u001b[38;2;243;244;246msmbd_up                     SMB        INFO        2026-10-06 18:08:27  SMBD process\u001b[0m\r\n\u001b[38;2;243;244;246mis now running.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mTIPS here only means perfmon sensors are not configured.\u001b[0m\r\n\u001b[38;2;243;244;246mAbout 50 minutes later they cleared on their own (verification\u001b[0m\r\n\u001b[38;2;243;244;246mrecording: smb_sensors_active at 18:58:27, SMB HEALTHY).\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-06 | Real commands, output, log times; generated pacing.\u001b[0m"]
