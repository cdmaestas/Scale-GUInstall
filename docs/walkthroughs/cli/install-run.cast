[0, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m01/16  A real run, command by command\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mREAL RUN | 2026-10-05 | IBM Storage Scale 6.0.1.1\u001b[0m\r\n\u001b[38;2;243;244;246mInstaller node plus seven cluster nodes | NFS, SMB and S3\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mCommands are the ones the backend executed on the installer\u001b[0m\r\n\u001b[38;2;243;244;246mnode. Output lines are quoted from its operation logs.\u001b[0m\r\n\u001b[38;2;243;244;246mThe toolkit path is shortened to \".../\" and INFO markers are\u001b[0m\r\n\u001b[38;2;243;244;246mdropped. Pacing is generated: per-line timing was not recorded.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mThe GUI and the MCP tools run these same commands.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[26.44, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m02/16  1. Start the installation service\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale setup -s 10.249.129.127\u001b[0m\r\n\u001b[38;2;243;244;246mYour ansible controller node has been configured to use the IP 10.249.129.127 to\u001b[0m\r\n\u001b[38;2;243;244;246mcommunicate with other nodes.\u001b[0m\r\n\u001b[38;2;243;244;246mPort 10080 will be used for package distribution.\u001b[0m\r\n\u001b[38;2;243;244;246mSUCCESS\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       2.8s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[47.55, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m03/16  2. Define the seven nodes\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale node delete scale-server1\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale node add scale-client1\u001b[0m\r\n\u001b[38;2;243;244;246m(one delete and one add for each of the seven nodes)\u001b[0m\r\n\u001b[38;2;243;244;246m[ FATAL ] Node scale-server1-rqhtc64k does not exist in the current configuration.\u001b[0m\r\n\u001b[38;2;243;244;246mCheck environment with 'spectrumscale node list'.\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] Found a mis-ordered line in the /etc/hosts file on scale-server1-rqhtc64k\u001b[0m\r\n\u001b[38;2;243;244;246mwhich is incorrectly formatted. This may affect initial cluster creation. In case of\u001b[0m\r\n\u001b[38;2;243;244;246mfailure during initial cluster creation, please format the entries in the /etc/hosts\u001b[0m\r\n\u001b[38;2;243;244;246mas '<IP> <FQDN> <ALIAS>') and retry\u001b[0m\r\n\u001b[38;2;243;244;246mAdding node scale-server1-rqhtc64k as a quorum node.\u001b[0m\r\n\u001b[38;2;243;244;246mAdding node scale-server1-rqhtc64k as an NSD server.\u001b[0m\r\n\u001b[38;2;243;244;246mSetting scale-gui1-rqhtc64k as an admin node.\u001b[0m\r\n\u001b[38;2;243;244;246mSetting scale-proto1-rqhtc64k as a protocol node.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[72.66, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m04/16  3. Read back the node table\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mGPFS                   Admin  Quorum  Manager   NSD   Protocol   GUI     OS   Arch\u001b[0m\r\n\u001b[38;2;243;244;246mNode                    Node   Node     Node   Server   Node    Server\u001b[0m\r\n\u001b[38;2;243;244;246mscale-client1-rqhtc64k                                                 rhel9  x86_64\u001b[0m\r\n\u001b[38;2;243;244;246mscale-client2-rqhtc64k                                                 rhel9  x86_64\u001b[0m\r\n\u001b[38;2;243;244;246mscale-gui1-rqhtc64k      X       X                                X    rhel9  x86_64\u001b[0m\r\n\u001b[38;2;243;244;246mscale-proto1-rqhtc64k                    X                X            rhel9  x86_64\u001b[0m\r\n\u001b[38;2;243;244;246mscale-proto2-rqhtc64k                    X                X            rhel9  x86_64\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server1-rqhtc64k           X       X       X                     rhel9  x86_64\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server2-rqhtc64k           X       X       X                     rhel9  x86_64\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m[Protocols]\u001b[0m\r\n\u001b[38;2;243;244;246mS3     : Enabled\u001b[0m\r\n\u001b[38;2;243;244;246mSMB    : Enabled\u001b[0m\r\n\u001b[38;2;243;244;246mNFS    : Enabled\u001b[0m\r\n\u001b[38;2;243;244;246mHDFS   : Disabled\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRead after the protocols were applied (step 6).\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[99.55, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m05/16  4. Define the storage\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale nsd add -p scale-server1 -u dataAndMetadata -fg 1 -fs\u001b[0m\r\n\u001b[38;2;243;244;246mcesSharedRoot /dev/vdd\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale nsd add -p scale-server2 -u dataOnly -fg 2 -po data -fs\u001b[0m\r\n\u001b[38;2;243;244;246mfs1 /dev/vdf\u001b[0m\r\n\u001b[38;2;243;244;246m(six NSD adds in all; the other four were not seen echoed)\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mName FS            Size(GB) Usage           FG Pool    Device   Servers\u001b[0m\r\n\u001b[38;2;243;244;246mnsd1 cesSharedRoot 100.0    dataAndMetadata 1  system  /dev/vdd scale-server1-rqhtc64k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd2 fs1           100.0    dataAndMetadata 1  Default /dev/vde scale-server1-rqhtc64k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd3 fs1           100.0    dataOnly        1  data    /dev/vdf scale-server1-rqhtc64k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd4 cesSharedRoot 100.0    dataAndMetadata 2  Default /dev/vdd scale-server2-rqhtc64k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd5 fs1           100.0    dataAndMetadata 2  Default /dev/vde scale-server2-rqhtc64k\u001b[0m\r\n\u001b[38;2;243;244;246mnsd6 fs1           100.0    dataOnly        2  data    /dev/vdf scale-server2-rqhtc64k\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[125.99, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m06/16  5. Call home and cluster settings\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale callhome disable\u001b[0m\r\n\u001b[38;2;243;244;246mDisabling the callhome.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale config gpfs --ephemeral_port_range 60000-61000\u001b[0m\r\n\u001b[38;2;243;244;246mSetting ephemeral_port_range to 60000-61000\u001b[0m\r\n\u001b[38;2;243;244;246mSetting perfmon to on\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mCall home is on by default; it must be configured or\u001b[0m\r\n\u001b[38;2;243;244;246mdisabled before the install precheck will pass.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[143.1, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m07/16  6. Configure and enable the protocols\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale config protocols -f cesSharedRoot -m /ibm/cesSharedRoot\u001b[0m\r\n\u001b[38;2;243;244;246m-i eth1 -e 10.249.128.200,10.249.128.201\u001b[0m\r\n\u001b[38;2;243;244;246mSetting export_ip_pool to ['10.249.128.200', '10.249.128.201']\u001b[0m\r\n\u001b[38;2;243;244;246mSetting filesystem to cesSharedRoot\u001b[0m\r\n\u001b[38;2;243;244;246mSetting mountpoint to /ibm/cesSharedRoot\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN ] CIDR value has not been passed with Export ces ip's, Installer will\u001b[0m\r\n\u001b[38;2;243;244;246mcontinue to work on Legacy mode.\u001b[0m\r\n\u001b[38;2;243;244;246mSetting interface to eth1\u001b[0m\r\n\u001b[38;2;243;244;246m[OK] Protocol configuration set.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale enable nfs smb s3\u001b[0m\r\n\u001b[38;2;243;244;246m[OK] Enabled: nfs, smb, s3.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[169.99, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m08/16  7. Precheck the install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale install --precheck\u001b[0m\r\n\u001b[38;2;243;244;246mGPFS precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mNetwork check from admin node scale-gui1-rqhtc64k to all other nodes in the cluster\u001b[0m\r\n\u001b[38;2;243;244;246mpassed\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] NSDs on the node scale-server1-rqhtc64k may not be load-balanced\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] Only one GUI server specified. The Graphical User Interface will not be\u001b[0m\r\n\u001b[38;2;243;244;246mhighly available.\u001b[0m\r\n\u001b[38;2;243;244;246m[ WARN  ] The NSD nsd1 only has one server configured. This may affect the ability\u001b[0m\r\n\u001b[38;2;243;244;246mto run concurrent maintenance on this cluster.\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server1-rqhtc64k     : ok=10   changed=0    unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=30   rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246mPre-check successful for install.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       1m 24.8s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[199.99, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m09/16  8. Run the install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale install\u001b[0m\r\n\u001b[38;2;243;244;246m4 x FAILED - RETRYING: wait-daemon-active (scale-server1)\u001b[0m\r\n\u001b[38;2;243;244;246m2 x FAILED - RETRYING: wait for gpfsgui (scale-gui1)\u001b[0m\r\n\u001b[38;2;243;244;246mTASK [ibm.spectrum_scale.core_configure : cluster | Create new cluster] ********\u001b[0m\r\n\u001b[38;2;243;244;246mTASK [ibm.spectrum_scale.core_configure : storage | Create new NSDs] ***********\u001b[0m\r\n\u001b[38;2;243;244;246mTASK [ibm.spectrum_scale.core_configure : storage | Create new filesystem(s)] ***\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server1-rqhtc64k     : ok=160  changed=38   unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=362  rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246mscale-gui1-rqhtc64k        : ok=90   changed=18   unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=165  rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246mInstallation successful. 7 GPFS nodes active in cluster scale-gui1-rqhtc64k.\u001b[0m\r\n\u001b[38;2;243;244;246mCompleted in 26 minutes 27 seconds.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[231.32, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m10/16  9. Check the install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale install --postcheck\u001b[0m\r\n\u001b[38;2;243;244;246m5 server licenses and 2 client licenses enabled on the cluster. Ensure enough\u001b[0m\r\n\u001b[38;2;243;244;246mlicenses are owned for this configuration.\u001b[0m\r\n\u001b[38;2;243;244;246mGPFS ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mNSDs ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mPerformance Monitoring ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mGUI ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mSUCCESS\u001b[0m\r\n\u001b[38;2;243;244;246mAll services running\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       12.7s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[255.1, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m11/16  10. Precheck the deploy\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale deploy --precheck\u001b[0m\r\n\u001b[38;2;243;244;246mNSDs are in a valid state\u001b[0m\r\n\u001b[38;2;243;244;246mprotocol precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mS3 precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mSMB precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mNFS precheck OK\u001b[0m\r\n\u001b[38;2;243;244;246mNetwork check from protocol node scale-proto1-rqhtc64k to all other protocol nodes\u001b[0m\r\n\u001b[38;2;243;244;246min the cluster passed\u001b[0m\r\n\u001b[38;2;243;244;246mPre-check successful for deploy.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       3m 55.2s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
[274.43, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m12/16  11. Deploy the protocols\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246m$ sudo -n .../spectrumscale deploy\u001b[0m\r\n\u001b[38;2;243;244;246mASYNC FAILED on scale-server1-rqhtc64k: jid=j57012116952.106400\u001b[0m\r\n\u001b[38;2;243;244;246mOne Ansible async job reported FAILED; the play went on.\u001b[0m\r\n\u001b[38;2;243;244;246mRecap: failed=0 everywhere, and the postcheck passes.\u001b[0m\r\n\u001b[38;2;243;244;246mThe cause of that line was not investigated.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mscale-server1-rqhtc64k     : ok=60   changed=11   unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=116  rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246mscale-proto1-rqhtc64k      : ok=34   changed=2    unreachable=0    failed=0\u001b[0m\r\n\u001b[38;2;243;244;246mskipped=72   rescued=0    ignored=0\u001b[0m\r\n\u001b[38;2;243;244;246mSuccessfully installed and configured protocols. 2 protocol nodes were enabled.\u001b[0m\r\n\u001b[38;2;243;244;246mComponents installed: Filesystem, Cluster Export Services, S3, SMB, NFS, Performance\u001b[0m\r\n\u001b[38;2;243;244;246mMonitoring, GUI, FILE AUDIT LOGGING. It took 17 minutes 26 seconds.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mOperation time       17m 28.2s\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mRECORDED RUN 2026-10-05 | Real commands and output; generated pacing.\u001b[0m"]
