[24.636, "o", "\u25cb nfs-ganesha.service - NFS-Ganesha file server\n     Active: inactive (dead)\n\u25cb rpcbind.service\n     Loaded: masked (Reason: Unit rpcbind.service is masked.)\n     Active: inactive (dead)\n"]
[25.636, "o", ""]
[26.136, "o", "\r\n\u001b[1;33m>>> ROOT CAUSE: rpcbind.service (and rpcbind.socket) are masked on this TechZone image <<<\u001b[0m\r\n"]
[26.536, "o", "\u001b[2m# Masking is a hard systemd block. GPFS's own `systemctl start rpcbind` call can't start a masked unit.\u001b[0m\r\n"]
[26.936, "o", "\u001b[2m# No rpcbind -> no portmapper -> NFS-Ganesha never comes up, regardless of the export IP fix.\u001b[0m\r\n"]
[27.336, "o", "\u001b[2m# SMB doesn't depend on rpcbind -- exactly why SMB alone stayed healthy.\u001b[0m\r\n"]
[28.536, "o", "\r\n"]
[29.136, "o", "\r\n\u001b[1;36m== ENVIRONMENT B -- confirming the fix, fresh reservation ==\u001b[0m\r\n"]
[29.736, "o", "\r\n\u001b[1;36m== 5. Pre-flight: check rpcbind BEFORE touching install ==\u001b[0m\r\n"]
