{"version": 2, "width": 88, "height": 24, "title": "Clean terminal installation overview", "duration": 181.11, "env": {"TERM": "xterm-256color"}}
[0, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m01/09  Clean terminal overview\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mINSTRUCTIONAL REENACTMENT \u2014 not one literal live run\u001b[0m\r\n\u001b[38;2;243;244;246mAssumes toolkit, SSH, rpcbind, reserved CES IPs and S3 media ready.\u001b[0m\r\n\u001b[38;2;243;244;246mSeven nodes; NFS, SMB and S3.\u001b[0m\r\n\u001b[38;2;243;244;246mPreflight details remain in the current runbook.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[21.56, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m02/09  1. Start the toolkit setup service\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale setup -s <installer-ip>\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mInstaller selected; package distribution service ready.\u001b[0m\r\n\u001b[38;2;243;244;246mUse the installer address assigned to your environment.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[40.45, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m03/09  2. Configure seven nodes\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mTwo storage servers: NSD, quorum, manager\u001b[0m\r\n\u001b[38;2;243;244;246mOne GUI node: GUI, quorum, admin\u001b[0m\r\n\u001b[38;2;243;244;246mTwo protocol nodes: protocol, manager\u001b[0m\r\n\u001b[38;2;243;244;246mTwo clients: client-only\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mReview all seven entries and role assignments.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[60.67, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m04/09  3. Define NSDs and filesystem placement\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mThree available disks on each storage server.\u001b[0m\r\n\u001b[38;2;243;244;246mOne per server -> cesSharedRoot\u001b[0m\r\n\u001b[38;2;243;244;246mTwo per server -> fs1\u001b[0m\r\n\u001b[38;2;243;244;246mSeparate failure groups for the two servers.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mVerify replica settings separately; placement is not proof of mirroring.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[83.11, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m05/09  4. Precheck and install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mResolve callhome configuration before the precheck.\u001b[0m\r\n\u001b[38;2;243;244;246mSet the intended GPFS port range.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale install --precheck\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale install\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mLong installation output is summarized in this overview.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[104.67, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m06/09  5. Verify the installation\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale install --postcheck\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mGPFS ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mNSDs ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mPerformance monitoring ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mGUI ACTIVE\u001b[0m\r\n\u001b[38;2;243;244;246mAll services running.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[122.67, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m07/09  6. Configure and precheck the protocols\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mConfigure CES filesystem, mountpoint, interface and reserved IPs.\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale enable nfs smb s3\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale deploy --precheck\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mReview NFS, SMB, S3 and shared protocol checks.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[141.11, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m08/09  7. Deploy the services\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale deploy\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mReview both task results and final service health.\u001b[0m\r\n\u001b[38;2;243;244;246mFilesystem, CES, NFS, SMB and S3 ACTIVE.\u001b[0m\r\n\u001b[38;2;243;244;246mMonitoring and GUI ACTIVE.\u001b[0m\r\n\u001b[38;2;243;244;246mThis is the illustrated successful path.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
[161.78, "o", "\u001b[2J\u001b[H\u001b[?25l\u001b[1;38;2;139;233;253m09/09  8. Verify the final state\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mspectrumscale deploy --postcheck\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mIndependently check the deployed components.\u001b[0m\r\n\u001b[38;2;243;244;246mConfirm all intended services are running.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mUse the runbook for prerequisites and environment-specific commands.\u001b[0m\r\n\u001b[38;2;243;244;246m\u001b[0m\r\n\u001b[38;2;243;244;246mEDITED REENACTMENT | Silent preview; narration supplied separately.\u001b[0m"]
