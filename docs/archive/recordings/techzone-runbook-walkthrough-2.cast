[32.064, "o", "[ INFO  ] Checking state of Cluster Export Services\r\n[ INFO  ] CES not healthy on all nodes\r\n[ INFO  ] Attempt 1 of 5 ... Attempt 5 of 5\r\n[ WARN  ] CES is not healthy on: scale-proto1, scale-proto2.\r\n[ FATAL ] Cluster Export Services NOT ACTIVE\r\n[ INFO  ] SMB ACTIVE\r\n[ FATAL ] NFS NOT ACTIVE\r\n[ INFO  ] Performance Monitoring ACTIVE\r\n[ INFO  ] GUI ACTIVE\r\n[ FATAL ] Not all services available on specified nodes\r\n"]
[32.864, "o", ""]
[33.264, "o", "\u001b[2m# SMB came up healthy -- proof the export-IP fix works. CES/NFS still failing.\u001b[0m\r\n"]
[52.064, "o", ""]
