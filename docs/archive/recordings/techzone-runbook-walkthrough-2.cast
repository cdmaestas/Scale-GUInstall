[109.136, "o", "\u25cb nfs-ganesha.service - NFS-Ganesha file server\r\n     Active: inactive (dead)\r\n\u25cb rpcbind.service\r\n     Loaded: masked (Reason: Unit rpcbind.service is masked.)\r\n     Active: inactive (dead)\r\n"]
[110.136, "o", ""]
[110.636, "o", "\r\n\u001b[1;33m>>> ROOT CAUSE: rpcbind.service (and rpcbind.socket) are masked on this TechZone image <<<\u001b[0m\r\n"]
[111.036, "o", "\u001b[2m# Masking is a hard systemd block. GPFS's own `systemctl start rpcbind` call can't start a masked unit.\u001b[0m\r\n"]
[111.436, "o", "\u001b[2m# No rpcbind -> no portmapper -> NFS-Ganesha never comes up, regardless of the export IP fix.\u001b[0m\r\n"]
[111.836, "o", "\u001b[2m# SMB doesn't depend on rpcbind -- exactly why SMB alone stayed healthy.\u001b[0m\r\n"]
[113.036, "o", "\r\n"]
[151.236, "o", ""]
[151.836, "o", "\r\n\u001b[1;36m== ENVIRONMENT B -- confirming the fix, fresh reservation ==\u001b[0m\r\n"]
