#!/usr/bin/env bash
# Pre-push: run the full CI-equivalent suite, including package builds
# when the tools are available locally.
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "pre-push: running pre-commit checks"
.githooks/pre-commit

if python3 -c "import pytest" &>/dev/null; then
  echo "pre-push: running pytest"
  python3 -m pytest tests/ -q
else
  echo "pre-push: WARN — pytest not installed; tests left to CI" >&2
fi

# The MCP server is its own package with its own deps and its own conftest, so
# its tests run as a separate pytest invocation (mirrors the CI job).
if python3 -c "import pytest, pytest_asyncio, mcp, httpx, scale_guinstall_mcp" &>/dev/null; then
  echo "pre-push: running mcp-server pytest"
  python3 -m pytest mcp-server/tests/ -q
else
  echo "pre-push: WARN — mcp-server test deps not installed (pip install -e './mcp-server[dev]'); left to CI" >&2
fi

if command -v dpkg-deb &>/dev/null || command -v rpmbuild &>/dev/null; then
  echo "pre-push: building packages"
  ./packaging/build-pkg.sh
else
  echo "pre-push: WARN — no rpmbuild/dpkg-deb; package build left to CI" >&2
fi

echo "pre-push: OK"
