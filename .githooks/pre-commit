#!/usr/bin/env bash
# Pre-commit: fast checks mirroring the CI python/shell/html jobs.
# Enable with:  git config core.hooksPath .githooks
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() { echo "pre-commit: FAIL — $1" >&2; exit 1; }

# Private scratch space (not fixed /tmp names, which another local user could pre-create).
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo "pre-commit: compiling scale-server.py"
python3 -m py_compile scale-server.py || fail "scale-server.py does not compile"

if command -v shellcheck &>/dev/null; then
  echo "pre-commit: shellcheck"
  shellcheck --severity=warning \
    start.sh \
    packaging/build-pkg.sh \
    packaging/scale-guinstall-wrapper \
    packaging/scale-guinstall-mmfs.sh \
    packaging/enable-ssh-forwarding.sh \
    packaging/debian/postinst \
    packaging/debian/prerm \
    packaging/debian/postrm \
    .githooks/pre-commit \
    .githooks/pre-push \
    || fail "shellcheck reported warnings"
else
  echo "pre-commit: WARN — shellcheck not installed, skipping shell lint" >&2
fi

if command -v ruff &>/dev/null; then
  echo "pre-commit: ruff"
  ruff check . || fail "ruff reported problems (config: ruff.toml)"
else
  echo "pre-commit: WARN — ruff not installed, skipping Python lint (pip install ruff)" >&2
fi

if command -v node &>/dev/null; then
  echo "pre-commit: JS syntax"
  python3 - "$TMP/app.js" <<'EOF' || fail "could not extract <script> block"
import re
import sys
html = open("Scale-GUInstall.html").read()
m = re.search(r"<script>(.*?)</script>", html, re.DOTALL)
assert m, "no <script> block found in Scale-GUInstall.html"
open(sys.argv[1], "w").write(m.group(1))
EOF
  node --check "$TMP/app.js" || fail "JavaScript in Scale-GUInstall.html does not parse"
else
  echo "pre-commit: WARN — node not installed, skipping JS syntax check" >&2
fi

echo "pre-commit: security guard"
sg_hits=0
sg_check() {
  # $1 = ERE pattern, $2 = file, $3 = description
  if grep -nE "$1" "$2" >"$TMP/sg"; then
    echo "pre-commit: FAIL — $3 in $2:" >&2
    cat "$TMP/sg" >&2
    sg_hits=1
  fi
}
for sg_file in scale-server.py mcp-server/src/scale_guinstall_mcp/*.py; do
  sg_check 'shell\s*=\s*True' "$sg_file" "shell=True (command injection risk)"
  sg_check '\bpickle\.(load|loads)\(' "$sg_file" "unsafe pickle deserialization"
  sg_check '\byaml\.load\(' "$sg_file" "unsafe yaml.load without SafeLoader"
  sg_check '\beval\(' "$sg_file" "eval() of untrusted input"
  # scale-server.py: any `except:` / `except Exception:` without a binding. The MCP
  # package has reviewed handlers that log via logger.exception, so only a truly
  # bare `except:` is forbidden there (bandit B110/B112 catch swallowed exceptions).
  if [ "$sg_file" = scale-server.py ]; then
    sg_check 'except\s*(Exception)?\s*:\s*$' "$sg_file" "bare except with no body — silent-failure regression"
  else
    sg_check 'except\s*:\s*$' "$sg_file" "bare except — silent-failure regression"
  fi
done
# innerHTML interpolations must route through h(); data-backup="${idx}" (loop
# index) and ${removeBtn} (locally-built trusted markup) are reviewed-safe.
sg_candidates=$(grep -nE '\.innerHTML\s*=.*\$\{' Scale-GUInstall.html || true)
sg_unescaped=$(echo "$sg_candidates" \
  | grep -vF 'h(' \
  | grep -vF 'data-backup="${idx}"' \
  | grep -vF '${removeBtn}' \
  || true)
if [ -n "$sg_unescaped" ]; then
  echo "pre-commit: FAIL — innerHTML interpolation without h():" >&2
  echo "$sg_unescaped" >&2
  sg_hits=1
fi
[ "$sg_hits" -eq 0 ] || fail "security guard found issues (see above)"

echo "pre-commit: HTML markers"
python3 - <<'EOF' || exit 1
import sys
with open("Scale-GUInstall.html") as f:
    html = f.read()
checks = {
    "h() escape helper": "function h(str)",
    "streamToTerminalPost": "async function streamToTerminalPost",
    "127.0.0.1 backend default": "127.0.0.1:5001",
    "help link": 'href="help.html"',
}
failed = [name for name, marker in checks.items() if marker not in html]
if failed:
    print(f"pre-commit: FAIL — missing HTML markers: {failed}", file=sys.stderr)
    sys.exit(1)
if not __import__("os").path.isfile("help.html"):
    print("pre-commit: FAIL — help.html is missing", file=sys.stderr)
    sys.exit(1)
EOF

echo "pre-commit: OK"
